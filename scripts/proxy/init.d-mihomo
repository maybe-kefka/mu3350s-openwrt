#!/bin/sh /etc/rc.common
# mihomo (Clash Meta) for F50/OpenWrt
USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/mihomo
CONF=/etc/mihomo/config.yaml

start_service() {
  /etc/mihomo/apply-tproxy.sh start
  procd_open_instance
  procd_set_param command "$PROG" -d /etc/mihomo -f "$CONF"
  procd_set_param respawn 3600 5 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param limits core="unlimited" nofile="65535"
  procd_set_param env TZ=Asia/Shanghai
  procd_close_instance
}

stop_service() {
  /etc/mihomo/apply-tproxy.sh stop
}

service_triggers() {
  procd_add_reload_trigger "network"
}
